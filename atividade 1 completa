#include <stdio.h>

int calcularTotalEstoque(int estoque[], int quantidade) {
    int total = 0;
    int i;

    for (i = 0; i < quantidade; i++) {
        total += estoque[i];
    }

    return total;
}

int contarEstoqueBaixo(int estoque[], int quantidade) {
    int contador = 0;
    int i;

    for (i = 0; i < quantidade; i++) {
        if (estoque[i] < 5) {
            contador++;
        }
    }

    return contador;
}

int buscarProduto(int estoque[], int codigo) {
    int indice;

    if (codigo < 1 || codigo > 8) {
        return -1;
    }

    indice = codigo - 1;

    return indice;
}

int main() {
    int estoque[8];
    int i, codigo;
    int total, baixo, posicao;

    for (i = 0; i < 8; i++) {
        printf("Digite a quantidade do produto %d: ", i + 1);
        scanf("%d", &estoque[i]);
    }

    total = calcularTotalEstoque(estoque, 8);

    baixo = contarEstoqueBaixo(estoque, 8);

    printf("\n--- RESULTADO DO ESTOQUE ---\n");
    printf("Total de unidades em estoque: %d\n", total);
    printf("Produtos com estoque baixo: %d\n", baixo);

    printf("\nDigite o codigo do produto que deseja buscar: ");
    scanf("%d", &codigo);

    posicao = buscarProduto(estoque, codigo);

    if (posicao != -1) {
        printf("Produto encontrado!\n");
        printf("Codigo: %d\n", codigo);
        printf("Posicao no vetor: %d\n", posicao);
        printf("Quantidade em estoque: %d\n", estoque[posicao]);
    } else {
        printf("Produto nao encontrado!\n");
    }

    return 0;
}
